# ==============================================================================
# FixPilot Configuration Environment Variables
# Nebius x NVIDIA Global AI Hackathon (Coding and Agentic Engineering Track)
# ==============================================================================

# NVIDIA API (build.nvidia.com - Primary Provider, unlimited)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Nebius Token Factory API (Optional / Secondary)
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# OpenRouter API (Fallback Provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Tavily Search API (Grounding & Search, targets $3,000 Bonus Prize)
TAVILY_API_KEY=your_tavily_api_key_here

# NVIDIA Open-Source Model IDs (Nemotron 3 Family)
MODEL_CLASSIFY=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
MODEL_ANALYZE=nvidia/nemotron-3-ultra-550b-a55b
MODEL_FIX=nvidia/nemotron-3-super-120b-a12b
MODEL_VALIDATE=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# OpenRouter Model Fallbacks (Nemotron variants with :free suffix)
FALLBACK_MODEL_CLASSIFY=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
FALLBACK_MODEL_ANALYZE=nvidia/nemotron-3-ultra-550b-a55b:free
FALLBACK_MODEL_FIX=nvidia/nemotron-3-super-120b-a12b:free

# Escalating timeout sequence (seconds per attempt: attempt 1 -> attempt 2 -> attempt 3)
LLM_TIMEOUT_SEQUENCE=30,60,90

# Agent State Machine Tuning
MAX_RETRIES=3
SANDBOX_TIMEOUT=30
MAX_CODE_LENGTH=50000

# Server
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=False
