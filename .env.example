# ==============================================================================
# FixPilot Configuration Environment Variables
# Nebius x NVIDIA Global AI Hackathon (Coding and Agentic Engineering Track)
# ==============================================================================

# Nebius Token Factory API (Primary)
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# OpenRouter API (Seamless Fallback while Nebius Builder approval is pending)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Tavily Search API (Grounding & Search, targets $3,000 Bonus Prize)
TAVILY_API_KEY=your_tavily_api_key_here

# NVIDIA Open-Source Model IDs (Nemotron 3 Family)
MODEL_CLASSIFY=nvidia/nemotron-3-nano
MODEL_ANALYZE=nvidia/nemotron-3-ultra
MODEL_FIX=nvidia/nemotron-3-super
MODEL_VALIDATE=nvidia/nemotron-3-nano

# OpenRouter Model Fallbacks (Nemotron variants)
FALLBACK_MODEL_CLASSIFY=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
FALLBACK_MODEL_ANALYZE=nvidia/nemotron-3-ultra
FALLBACK_MODEL_FIX=nvidia/nemotron-3-super

# Agent State Machine Tuning
MAX_RETRIES=3
SANDBOX_TIMEOUT=30
MAX_CODE_LENGTH=50000

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False
